###############################################################################
# SilverBullet Libraries
###############################################################################

-include .env
export

.DEFAULT_GOAL := help

SB_IMAGE ?= ghcr.io/silverbulletmd/silverbullet:latest
SB_CONTAINER ?= silverbullet-test
SB_HOST_PORT ?= 3000
KB_BASE_URL ?= https://kanboard.mydomain.com
KB_TOKEN ?= 5ec7e7
KB_USERNAME ?= me@mydomain.com
KB_PROJECT_ID ?= 1
KB_VERBOSITY ?= 1
IG_DIRECTORY ?= Images
IG_COLS ?= 3
IG_ROWS ?= 2
IG_WIDTH ?= 200
IG_HEIGHT ?= 150
# OPEN_COMMAND can be overridden on Linux with xdg-open
OPEN_COMMAND ?= open
TEST_SPACE_DIR ?= test/space
TEST_BUILD_DIR ?= test/build
TEST_TEST_DIR ?= test/test

###############################################################################
# Libraries
#
# Every library lives in src/<lib>/ and is versioned and released on its own.
# For each library <lib> listed here, define:
#
#   <lib>_PAGE  name of the published page (and of the built markdown file)
#   <lib>_DOCS  documentation fragments, concatenated in this order
#   <lib>_LUA   Lua fragments, concatenated in this order into one
#               space-lua block
#
# and keep its version in src/<lib>/RELEASE_MAJOR, RELEASE_MINOR and
# RELEASE_PATCH.
###############################################################################

LIBRARIES := kanboard imagegallery

kanboard_PAGE := Kanboard
kanboard_DOCS := kanboard.md
kanboard_LUA := library.lua kanboard.lua

imagegallery_PAGE := ImageGallery
imagegallery_DOCS := imagegallery.md
imagegallery_LUA := imagegallery.lua

# Release/versioning
RELEASE_MAJOR_FILE ?= RELEASE_MAJOR
RELEASE_MINOR_FILE ?= RELEASE_MINOR
RELEASE_PATCH_FILE ?= RELEASE_PATCH
RELEASE_DIR ?= releases

.PHONY: help all build clean test testspace release changelog $(LIBRARIES)

###############################################################################
# Build
#
# One rule builds every library: page frontmatter, an autogenerated note, the
# documentation fragments, then the Lua fragments wrapped in a single
# space-lua block.
###############################################################################

all: $(LIBRARIES)

build: all

$(LIBRARIES):
	@echo "Building $($@_PAGE)..."
	@mkdir -p "$(TEST_BUILD_DIR)"
	@cat src/$@/frontmatter.md > "$(TEST_BUILD_DIR)/$($@_PAGE).md"
	@printf "%s\n" \
		"> **note**" \
		"> This file is autogenerated by 'make'." \
		"> Edits should be made in the files under src/$@/." >> \
		"$(TEST_BUILD_DIR)/$($@_PAGE).md"
	@cat $(addprefix src/$@/,$($@_DOCS)) >> "$(TEST_BUILD_DIR)/$($@_PAGE).md"
	@echo "" >> "$(TEST_BUILD_DIR)/$($@_PAGE).md"
	@echo '```space-lua' >> "$(TEST_BUILD_DIR)/$($@_PAGE).md"
	@cat $(addprefix src/$@/,$($@_LUA)) >> "$(TEST_BUILD_DIR)/$($@_PAGE).md"
	@echo "" >> "$(TEST_BUILD_DIR)/$($@_PAGE).md"
	@echo '```' >> "$(TEST_BUILD_DIR)/$($@_PAGE).md"
	@echo "Done."

###############################################################################
# Test
###############################################################################

test: all testspace
	@echo "Stopping any existing SilverBullet container..."
	@docker stop "$(SB_CONTAINER)" >/dev/null 2>&1 || true
	@echo "Starting SilverBullet in Docker..."
	@docker run --rm -d --name "$(SB_CONTAINER)" \
		-p $(SB_HOST_PORT):3000 \
		-v "$(CURDIR)/$(TEST_TEST_DIR):/space" \
		$(SB_IMAGE)
	@sleep 3
	@echo "Opening SilverBullet at http://localhost:$(SB_HOST_PORT)..."
	@$(OPEN_COMMAND) "http://localhost:$(SB_HOST_PORT)"

testspace: all
	@echo "Preparing SilverBullet testspace..."
	@mkdir -p "$(TEST_TEST_DIR)"
	@mkdir -p "$(TEST_TEST_DIR)/Library/Finestream"
	@if [ -d "$(TEST_SPACE_DIR)" ]; then \
		cp -R "$(TEST_SPACE_DIR)/." "$(TEST_TEST_DIR)/"; \
	fi
	@$(foreach lib,$(LIBRARIES),cp "$(TEST_BUILD_DIR)/$($(lib)_PAGE).md" \
		"$(TEST_TEST_DIR)/Library/Finestream/$($(lib)_PAGE).md";)
	@printf '%s\n' '```space-lua' > "$(TEST_TEST_DIR)/CONFIG.md"
	@printf '%s\n' 'config.set {' >> "$(TEST_TEST_DIR)/CONFIG.md"
	@printf '%s\n' '  kanboard = {' >> "$(TEST_TEST_DIR)/CONFIG.md"
	@printf '      kbBaseUrl = "%s", -- Kanboard base URL\n' \
		"$(KB_BASE_URL)" \
		>> "$(TEST_TEST_DIR)/CONFIG.md"
	@printf '      sbBaseUrl = "%s", -- Silverbullet base URL\n' \
		"http://localhost:$(SB_HOST_PORT)" \
		>> "$(TEST_TEST_DIR)/CONFIG.md"
	@printf '      kbUsername = "%s", -- Kanboard username\n' \
		"$(KB_USERNAME)" \
		>> "$(TEST_TEST_DIR)/CONFIG.md"
	@printf '      kbToken = "%s", -- Kanboard token for username\n' \
		"$(KB_TOKEN)" \
		>> "$(TEST_TEST_DIR)/CONFIG.md"
	@printf '      kbProjectId = %s, -- default projectId in Kanboard\n' \
		"$(KB_PROJECT_ID)" \
		>> "$(TEST_TEST_DIR)/CONFIG.md"
	@printf '%s\n' '      sbCachePath = "Kanboard", -- Path on Silverbullet space for cache' \
		>> "$(TEST_TEST_DIR)/CONFIG.md"
	@printf '%s\n' '      sbCacheRefreshHours = 6, -- max cache age in hours' \
		>> "$(TEST_TEST_DIR)/CONFIG.md"
	@printf '%s\n' '      kbCloseDone = false, -- close done tasks when syncing status' \
		>> "$(TEST_TEST_DIR)/CONFIG.md"
	@printf '%s\n' '      kbMoveDone = true, -- move done tasks to the last Kanboard column when syncing status' \
		>> "$(TEST_TEST_DIR)/CONFIG.md"
	@printf '      verbosity = %s, -- 0 silent, 1 errors, 2 +warnings, 3 +info, 4 +debug\n' \
		"$(KB_VERBOSITY)" \
		>> "$(TEST_TEST_DIR)/CONFIG.md"
	@printf '%s\n' '  },' >> "$(TEST_TEST_DIR)/CONFIG.md"
	@printf '%s\n' '  imagegallery = {' >> "$(TEST_TEST_DIR)/CONFIG.md"
	@printf '      directory = "%s", -- directory proposed by the insert command\n' \
		"$(IG_DIRECTORY)" \
		>> "$(TEST_TEST_DIR)/CONFIG.md"
	@printf '      cols = %s, -- thumbnails per row\n' \
		"$(IG_COLS)" \
		>> "$(TEST_TEST_DIR)/CONFIG.md"
	@printf '      rows = %s, -- rows per gallery page\n' \
		"$(IG_ROWS)" \
		>> "$(TEST_TEST_DIR)/CONFIG.md"
	@printf '      width = %s, -- thumbnail bounding box width in pixels\n' \
		"$(IG_WIDTH)" \
		>> "$(TEST_TEST_DIR)/CONFIG.md"
	@printf '      height = %s, -- thumbnail bounding box height in pixels\n' \
		"$(IG_HEIGHT)" \
		>> "$(TEST_TEST_DIR)/CONFIG.md"
	@printf '%s\n' '  }' >> "$(TEST_TEST_DIR)/CONFIG.md"
	@printf '%s\n' '}' >> "$(TEST_TEST_DIR)/CONFIG.md"
	@printf '%s\n' '```' >> "$(TEST_TEST_DIR)/CONFIG.md"
	@echo "Testspace ready at $(TEST_TEST_DIR)."

###############################################################################
# Release
#
# Libraries are released independently: 'release-<lib>' publishes one library,
# 'release' publishes every library whose version has been bumped since its
# last release. A library whose version is already published is skipped, so
# releasing all of them never republishes an unchanged one.
#
# Each release writes releases/<Page>.md and releases/<Page>.VERSION and tags
# the commit as <lib>-vX.Y.Z.
###############################################################################

# Note: the per-library targets below come from pattern rules, and GNU make
# skips the implicit rule search for targets declared .PHONY, so they must not
# be listed there. They never produce a file of their own name.
.PHONY: release versions

release: $(addprefix release-,$(LIBRARIES))

release-%: %
	@page="$($*_PAGE)"; \
	major=$$(cat src/$*/$(RELEASE_MAJOR_FILE) 2>/dev/null || echo 0); \
	minor=$$(cat src/$*/$(RELEASE_MINOR_FILE) 2>/dev/null || echo 0); \
	patch=$$(cat src/$*/$(RELEASE_PATCH_FILE) 2>/dev/null || echo 0); \
	ver=$$major.$$minor.$$patch; \
	if [ -f "$(RELEASE_DIR)/$$page.VERSION" ] && \
		[ "$$ver" = "$$(cat $(RELEASE_DIR)/$$page.VERSION)" ]; then \
		echo "$$page $$ver is already released, skipping"; \
		echo "  bump it first with 'make bump-fix-$*' or 'make bump-feature-$*'"; \
		exit 0; \
	fi; \
	mkdir -p "$(RELEASE_DIR)"; \
	cp "$(TEST_BUILD_DIR)/$$page.md" "$(RELEASE_DIR)/$$page.md"; \
	echo "$$ver" > "$(RELEASE_DIR)/$$page.VERSION"; \
	git tag -a "$*-v$$ver" -m "$$page release $$ver" || \
		echo "git tag failed (maybe already exists)"; \
	echo "Published $(RELEASE_DIR)/$$page.md (VERSION=$$ver)"

versions: $(addprefix version-,$(LIBRARIES))

version-%:
	@page="$($*_PAGE)"; \
	major=$$(cat src/$*/$(RELEASE_MAJOR_FILE) 2>/dev/null || echo 0); \
	minor=$$(cat src/$*/$(RELEASE_MINOR_FILE) 2>/dev/null || echo 0); \
	patch=$$(cat src/$*/$(RELEASE_PATCH_FILE) 2>/dev/null || echo 0); \
	released=$$(cat "$(RELEASE_DIR)/$$page.VERSION" 2>/dev/null || echo "none"); \
	printf '%-14s source %-8s released %s\n' \
		"$$page" "$$major.$$minor.$$patch" "$$released"

# bump-feature-<lib>: increment Y (feature) and reset Z (patch)
bump-feature-%:
	@major=$$(cat src/$*/$(RELEASE_MAJOR_FILE) 2>/dev/null || echo 0); \
	minor=$$(cat src/$*/$(RELEASE_MINOR_FILE) 2>/dev/null || echo 0); \
	minor=$$((minor+1)); \
	echo $$minor > src/$*/$(RELEASE_MINOR_FILE); \
	echo 0 > src/$*/$(RELEASE_PATCH_FILE); \
	echo "Bumped $($*_PAGE) feature to $$major.$$minor.0"

# bump-fix-<lib>: increment Z (patch)
bump-fix-%:
	@major=$$(cat src/$*/$(RELEASE_MAJOR_FILE) 2>/dev/null || echo 0); \
	minor=$$(cat src/$*/$(RELEASE_MINOR_FILE) 2>/dev/null || echo 0); \
	patch=$$(cat src/$*/$(RELEASE_PATCH_FILE) 2>/dev/null || echo 0); \
	patch=$$((patch+1)); \
	echo $$patch > src/$*/$(RELEASE_PATCH_FILE); \
	echo "Bumped $($*_PAGE) patch to $$major.$$minor.$$patch"

###############################################################################
# Help
###############################################################################

help:
	@printf "Finestream's SilverBullet Libraries:\n"
	@printf "====================================\n\n"
	@printf "Libraries: $(LIBRARIES)\n"
	@printf "\nAvailable targets:\n"
	@printf "\nBuild:\n"
	@printf "  all\t\t\tBuild all libraries\n"
	@printf "  build\t\t\tAlias for all\n"
	@printf "  <lib>\t\t\tBuild a single library, e.g. 'make imagegallery'\n"
	@printf "\nTest:\n"
	@printf "  test\t\t\tPrepare the testspace, start SilverBullet in"
	@printf " Docker,\n    and open it in a browser\n"
	@printf "  testspace\t\tPrepare the SilverBullet testspace and copy the\n"
	@printf "    built libraries into it\n"
	@printf "\nRelease and versioning (per library):\n"
	@printf "  release\t\tPublish every library that has been bumped\n"
	@printf "  release-<lib>\t\tPublish one library\n"
	@printf "  bump-feature-<lib>\tIncrement one library's feature version and\n"
	@printf "    reset its patch version\n"
	@printf "  bump-fix-<lib>\tIncrement one library's patch version\n"
	@printf "  versions\t\tShow source and released version of each library\n"
	@printf "\nMaintenance:\n"
	@printf "  clean\t\t\tStop the SilverBullet test container and remove\n"
	@printf "    generated test files\n"
	@printf "  help\t\t\tShow this help message\n"
	@printf "\nEnvironment vars:\n"
	@printf "  SB_HOST_PORT\tHost port for Docker port mapping (default: 3000)\n"
	@printf "  KB_BASE_URL\tKanboard base URL used in CONFIG.md\n"
	@printf "  KB_TOKEN\tKanboard token used in CONFIG.md\n"
	@printf "  KB_USERNAME\tKanboard username used in CONFIG.md\n"
	@printf "  KB_PROJECT_ID\tKanboard project ID used in CONFIG.md (default: 1)\n"
	@printf "  KB_VERBOSITY\tKanboard notification level 0-4 used in CONFIG.md (default: 1)\n"
	@printf "  IG_DIRECTORY\tImageGallery default directory used in CONFIG.md\n"
	@printf "  IG_COLS\tImageGallery default columns used in CONFIG.md\n"
	@printf "  IG_ROWS\tImageGallery default rows used in CONFIG.md\n"
	@printf "  IG_WIDTH\tImageGallery default thumbnail width in CONFIG.md\n"
	@printf "  IG_HEIGHT\tImageGallery default thumbnail height in CONFIG.md\n"
	@printf "  OPEN_COMMAND\tCommand to open the default browser (default: open)\n"
	@printf "  SB_IMAGE\tDocker image to run for SilverBullet\n"
	@printf "  SB_CONTAINER\tName for the SilverBullet Docker container\n"

###############################################################################
# Clean
###############################################################################

# Clean removes the SilverBullet test container and deletes generated test
# directories so the environment is reset for the next run.
clean:
	@echo "Cleaning..."
	@docker rm -f "$(SB_CONTAINER)" >/dev/null 2>&1 || true
	@rm -rf test/build test/test
	@echo "Done."
